{
    "name": "nestjs-authentication",
    "version": "0.5.0",
    "description": "A NestJS module that supports multiple authentication providers, built on passport",
    "keywords": [
        "nestjs",
        "module",
        "authentication",
        "passport",
        "jwt",
        "session",
        "guard"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "!dist/**/*.tsbuildinfo",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pop-Code/nestjs-authentication.git"
    },
    "author": "Rmannn <alex.hermann@pop-code.com>",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "passport": "^0.6.0 || ^0.7.0"
    },
    "peerDependenciesMeta": {
        "passport": {
            "optional": true
        }
    },
    "dependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "jsonwebtoken": "^9.0.3"
    },
    "devDependencies": {
        "@apollo/server": "5.5.2",
        "@as-integrations/express5": "1.1.2",
        "@eslint/js": "10.0.1",
        "@nestjs/apollo": "14.2.1",
        "@nestjs/common": "12.5.0",
        "@nestjs/core": "12.5.0",
        "@nestjs/graphql": "14.2.1",
        "@nestjs/microservices": "12.5.0",
        "@nestjs/passport": "12.0.2",
        "@nestjs/platform-express": "12.5.0",
        "@nestjs/platform-fastify": "12.5.0",
        "@nestjs/platform-socket.io": "12.5.0",
        "@nestjs/testing": "12.5.0",
        "@nestjs/websockets": "12.5.0",
        "@types/express": "5.0.6",
        "@types/express-session": "1.19.0",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "@types/passport": "1.0.17",
        "@types/passport-local": "1.0.38",
        "@types/passport-strategy": "0.2.38",
        "@types/supertest": "7.2.1",
        "@types/ws": "8.18.2",
        "eslint": "10.15.0",
        "express-session": "1.19.0",
        "graphql": "16.11.0",
        "graphql-ws": "6.4.2",
        "jest": "30.5.2",
        "passport": "0.7.0",
        "passport-local": "1.0.0",
        "passport-strategy": "1.0.0",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "socket.io-client": "4.8.4",
        "supertest": "7.3.2",
        "ts-jest": "29.4.15",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "ws": "8.23.0"
    },
    "scripts": {
        "build": "rm -Rf ./dist ./tsconfig.build.tsbuildinfo && tsc -b tsconfig.build.json",
        "format": "prettier \"**/*.ts\" --ignore-path ./.prettierignore --write && git status",
        "lint": "eslint ./src ./test",
        "doc": "rm -Rf ./docs && typedoc && touch ./docs/.nojekyll",
        "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
        "test:smoke": "node -e \"const m = require('./dist'); if (typeof m.AuthModule !== 'function' || typeof m.AuthGuard !== 'function') process.exit(1)\" && node test/smoke/no-passport.js ./dist",
        "prepublishOnly": "npm run build"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/index.ts"
        ],
        "coverageDirectory": "./coverage"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "homepage": "https://pop-code.github.io/nestjs-authentication"
}
